{
  "$schema": "https://json-schema.org/v3/2020-12/schema",
  "$id": "urn:vella:pq-review:envelope:1",
  "$comment": "Review v3. Exact Base64 decoding, key identity, signatures, payload domain and total byte limits require the normative verifier.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "payload_type",
    "suite",
    "digest_profile",
    "payload",
    "keys",
    "signatures",
    "payload_hash"
  ],
  "properties": {
    "kind": {
      "const": "vella_proof_bundle_v3"
    },
    "payload_type": {
      "const": "application/vnd.vella.authorization.v3+json"
    },
    "suite": {
      "const": "p256+ml-dsa-65"
    },
    "digest_profile": {
      "const": "sha384-jcs-v1"
    },
    "payload": {
      "type": "string",
      "minLength": 4,
      "maxLength": 1398104,
      "pattern": "^[A-Za-z0-9+/]+={0,2}$"
    },
    "keys": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecdsa-p256-sha256",
        "ml-dsa-65"
      ],
      "properties": {
        "ecdsa-p256-sha256": {
          "type": "string",
          "pattern": "^sha384:[a-f0-9]{96}$"
        },
        "ml-dsa-65": {
          "type": "string",
          "pattern": "^sha384:[a-f0-9]{96}$"
        }
      }
    },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ecdsa-p256-sha256",
        "ml-dsa-65"
      ],
      "properties": {
        "ecdsa-p256-sha256": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        },
        "ml-dsa-65": {
          "type": "string",
          "minLength": 4412,
          "maxLength": 4412,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      }
    },
    "payload_hash": {
      "type": "string",
      "pattern": "^sha384:[a-f0-9]{96}$"
    }
  }
}
